{
  "name": "@rivia-labs/minitrigger",
  "version": "0.4.0",
  "description": "Durable tasks and workflows for Node.js on BullMQ + Redis + Postgres, as an installable library.",
  "keywords": [
    "durable-execution",
    "workflow",
    "workflow-engine",
    "task-queue",
    "background-jobs",
    "durable-functions",
    "bullmq",
    "postgres",
    "redis",
    "orchestration",
    "retry",
    "cron",
    "scheduler"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/igorabreu29/minitrigger.git"
  },
  "homepage": "https://github.com/igorabreu29/minitrigger#readme",
  "bugs": {
    "url": "https://github.com/igorabreu29/minitrigger/issues"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.3.4",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSE",
    "skills",
    "docs/pt",
    ".claude-plugin"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "testing": [
        "./dist/testing/index.d.ts"
      ],
      "typeorm": [
        "./dist/typeorm/index.d.ts"
      ],
      "knex": [
        "./dist/knex/index.d.ts"
      ],
      "drizzle": [
        "./dist/drizzle/index.d.ts"
      ],
      "prisma": [
        "./dist/prisma/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.js"
      },
      "require": {
        "types": "./dist/testing/index.d.cts",
        "default": "./dist/testing/index.cjs"
      }
    },
    "./typeorm": {
      "import": {
        "types": "./dist/typeorm/index.d.ts",
        "default": "./dist/typeorm/index.js"
      },
      "require": {
        "types": "./dist/typeorm/index.d.cts",
        "default": "./dist/typeorm/index.cjs"
      }
    },
    "./knex": {
      "import": {
        "types": "./dist/knex/index.d.ts",
        "default": "./dist/knex/index.js"
      },
      "require": {
        "types": "./dist/knex/index.d.cts",
        "default": "./dist/knex/index.cjs"
      }
    },
    "./drizzle": {
      "import": {
        "types": "./dist/drizzle/index.d.ts",
        "default": "./dist/drizzle/index.js"
      },
      "require": {
        "types": "./dist/drizzle/index.d.cts",
        "default": "./dist/drizzle/index.cjs"
      }
    },
    "./prisma": {
      "import": {
        "types": "./dist/prisma/index.d.ts",
        "default": "./dist/prisma/index.js"
      },
      "require": {
        "types": "./dist/prisma/index.d.cts",
        "default": "./dist/prisma/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "prepare": "tsup",
    "prepublishOnly": "pnpm typecheck && pnpm lint && pnpm test:unit",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run --project unit --project integration && vitest run --project flushall",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:flushall": "vitest run --project flushall",
    "test:watch": "vitest",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "bench": "pnpm run build && node bench/run.ts",
    "check:pack": "node scripts/check-pack.mjs",
    "skills:validate": "claude plugin validate ."
  },
  "dependencies": {
    "cron-parser": "5.10.1"
  },
  "peerDependencies": {
    "@types/pg": "^8.11.0",
    "bullmq": "^6.3.0",
    "ioredis": "^5.11.1",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@types/node": "^24.13.6",
    "@types/pg": "8.23.1",
    "bullmq": "^6.3.8",
    "drizzle-orm": "^0.45.3",
    "ioredis": "^5.11.1",
    "knex": "^3.3.0",
    "pg": "^8.23.0",
    "postgres": "^3.4.9",
    "prisma": "7.10.0",
    "tsup": "8.5.1",
    "typeorm": "^1.1.1",
    "typescript": "6.0.3",
    "vite": "^8.3.0",
    "vitest": "5.0.1"
  },
  "peerDependenciesMeta": {
    "@types/pg": {
      "optional": true
    },
    "bullmq": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    }
  }
}
