{
  "name": "minitrigger",
  "version": "0.1.0",
  "description": "Durable tasks and workflows for Node.js on BullMQ + Redis + Postgres, as an installable library.",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/igorabreu29/minitrigger.git"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.3.4",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "prepare": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run --project unit --project integration && vitest run --project flushall",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:flushall": "vitest run --project flushall",
    "test:watch": "vitest",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "bench": "pnpm run build && node bench/run.ts",
    "check:pack": "node scripts/check-pack.mjs"
  },
  "peerDependencies": {
    "bullmq": "^6.3.0",
    "ioredis": "^5.11.1",
    "pg": "^8.13.0",
    "@types/pg": "^8.11.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "^24.13.6",
    "@types/pg": "8.23.1",
    "bullmq": "^6.3.8",
    "ioredis": "^5.11.1",
    "pg": "^8.23.0",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vite": "^8.3.0",
    "vitest": "5.0.1"
  },
  "peerDependenciesMeta": {
    "@types/pg": {
      "optional": true
    }
  }
}
